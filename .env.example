# Variables de entorno de embolsadora4.0-cloud.
# Fuente: internal/config/config.go. [obligatoria] = config.Load falla si falta;
# el resto es opcional y se muestra con su default.
#
# En local: copiar a .env.local (config.LoadEnvFile carga .env.<APP_ENV>).
# En producción (Cloud Run) se configuran en el servicio; las variables del
# sistema tienen prioridad sobre el archivo.

# ── Ambiente ─────────────────────────────────────────────────────────────────
# local | beta | production. Default: local (valores desconocidos caen a local).
APP_ENV=local

# ── HTTP ─────────────────────────────────────────────────────────────────────
PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
# CORS: hoy el middleware responde Access-Control-Allow-Origin: * y no lee
# ninguna variable (ver CORS() en internal/api/middleware/middleware.go).

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# [obligatoria]
DATABASE_URL=postgres://<usuario>:<password>@<host>:5432/<dbname>?sslmode=disable
# Se leen pero hoy no tienen efecto: el pool se crea solo desde DATABASE_URL.
# DB_MAX_CONNS=10
# DB_MIN_CONNS=2
# DB_CONN_MAX_LIFETIME=30m
# Aplicar migraciones pendientes al arrancar (internal/platform/dbmigrate).
RUN_MIGRATIONS_ON_BOOT=false
# Default: la ruta dentro de la imagen Docker. En local: file://migrations
MIGRATIONS_SOURCE_URL=file:///app/migrations

# ── Redis (opcional) ─────────────────────────────────────────────────────────
# Vacía o inalcanzable: rate limit y caché de API keys fallan abiertos.
REDIS_URL=redis://:<password>@<host>:6379/0

# ── MongoDB (mediciones de la ingesta del Edge Pi) ───────────────────────────
# Default: mongodb://localhost:27017. Si no es alcanzable al arrancar, el
# proceso NO se cae: la ingesta responde 500 (el Edge reintenta con backoff) y
# el resto de la API sigue. En un deploy real hay que setearla.
MONGO_URI=mongodb://<usuario>:<password>@<host>:27017
# Default: embolsadora. MONGO_DB se acepta como fallback legacy (PR #30).
MONGO_DATABASE=embolsadora
# Timeout de conexión y de selección de servidor.
MONGO_TIMEOUT=10s

# ── Ingesta (POST /api/v1/consumers/events) ──────────────────────────────────
# 4 MiB, no 2: el Edge corta sus batches en BATCH_MAX_BYTES=2097152 exactos;
# rechazar a partir de 2 MiB inclusive mandaría a DEAD hasta 1000 eventos por
# un byte de desajuste.
INGEST_MAX_BODY_BYTES=4194304
INGEST_MAX_EVENTS=1000
INGEST_RATE_LIMIT_RPS=200
INGEST_RATE_LIMIT_BURST=1000
# TTL de la caché de API keys resueltas (evita un roundtrip a Postgres por
# request en el camino caliente de la ingesta).
APIKEY_CACHE_TTL=60s

# ── Supabase ─────────────────────────────────────────────────────────────────
# [obligatoria]
SUPABASE_URL=https://<project-id>.supabase.co
# [obligatoria]
SUPABASE_JWKS_URL=https://<project-id>.supabase.co/auth/v1/.well-known/jwks.json
# [obligatoria]
SUPABASE_JWT_ISSUER=https://<project-id>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# [obligatoria] Admin API (invitaciones, recovery). Secreto.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Usada por POST /api/v1/auth/login. Default: vacía.
SUPABASE_ANON_KEY=<anon-key>

# ── Frontend (links en mails) ────────────────────────────────────────────────
# [obligatoria] Fallback para los links de mail.
APP_BASE_URL=http://localhost:3000
# Origins del frontend en los que se confía para armar links de mail, separados
# por comas. El BFF manda el suyo en X-App-Base-URL y se valida contra esta
# lista. "https://*.vercel.app" habilita los previews (solo subdominios). Si el
# header falta o no matchea, se usa APP_BASE_URL. Default: vacía.
APP_ALLOWED_ORIGINS=http://localhost:3000,https://embolsadora.site

# ── Invitaciones ─────────────────────────────────────────────────────────────
INVITATION_RATE_LIMIT_PER_HOUR=20

# ── Observabilidad ───────────────────────────────────────────────────────────
# debug | info | warn | error. Se lee pero hoy no tiene efecto: el logger es
# zap.NewDevelopment() en todos los ambientes.
LOG_LEVEL=info

# ── Dashboards (Dashboard Metrics Query API) ─────────────────────────────────
DASHBOARDS_METRICS_RATE_LIMIT_RPM=15
DASHBOARDS_METRICS_RATE_LIMIT_BURST=5
DASHBOARDS_METRICS_MAX_SPECS=10
DASHBOARDS_METRICS_MAX_BUCKETS=1000
DASHBOARDS_METRICS_MAX_RAW_POINTS=5000
DASHBOARDS_METRICS_MAX_GROUPS=200
DASHBOARDS_METRICS_MAX_BATCH_QUERIES=50
DASHBOARDS_METRICS_MAX_TIME_MS=5000
