# Ambiente: local | beta | production
# En local se carga desde .env.local; en Koyeb/PaaS se inyecta directamente.
APP_ENV=local

# ── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgres://<usuario>:<password>@<host>:5432/<dbname>?sslmode=disable

# ── Redis (opcional — rate limiting falla abierto si no está disponible) ─────
REDIS_URL=redis://:<password>@<host>:6379/0

# ── MongoDB (mediciones de la ingesta de Edge Pi) ─────────────────────────────
# Si esta URI no es alcanzable al arrancar, el proceso NO se cae: la ingesta
# responde 500 (el Edge reintenta con backoff, I-1) y el resto de la API sigue
# arriba con normalidad. El default de MONGO_URI apunta a localhost — en un
# deploy real hay que setearla, o la ingesta queda degradada desde el arranque.
MONGO_URI=mongodb://<usuario>:<password>@<host>:27017
MONGO_DATABASE=embolsadora
# Timeout de conexion y de seleccion de servidor contra Mongo.
MONGO_TIMEOUT=10s

# ── Ingesta (POST /api/v1/consumers/events) ───────────────────────────────────
# 4 MiB, no 2: el Edge corta sus batches en BATCH_MAX_BYTES=2097152 exactos;
# rechazar a partir de 2 MiB inclusive mandaria a DEAD hasta 1000 eventos por
# un byte de desajuste (ver internal/config/config.go).
INGEST_MAX_BODY_BYTES=4194304
INGEST_MAX_EVENTS=1000
INGEST_RATE_LIMIT_RPS=200
INGEST_RATE_LIMIT_BURST=1000
# TTL de la cache de API keys resueltas (evita un roundtrip a Postgres por
# request en el camino caliente de la ingesta).
APIKEY_CACHE_TTL=60s

# ── HTTP ─────────────────────────────────────────────────────────────────────
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_JWKS_URL=https://<project-id>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<project-id>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_ANON_KEY=<anon-key>

# ── Frontend (para links en emails) ──────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
# Origins del frontend en los que se confia para armar links de mail.
# Lista separada por comas.
# El BFF manda el suyo en el header X-App-Base-URL y se valida contra esta lista.
# Una entrada "https://*.vercel.app" habilita los previews (subdominios unicamente).
# Si el header falta o no matchea, se usa APP_BASE_URL.
APP_ALLOWED_ORIGINS=http://localhost:3000,https://embolsadora.site

# ── Rate limiting ─────────────────────────────────────────────────────────────
INVITATION_RATE_LIMIT_PER_HOUR=20

# ── Observabilidad ────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
